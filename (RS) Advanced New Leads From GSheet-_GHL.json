    {
      "parameters": {
        "jsCode": "// CSV string is coming in as $json.data\nconst csvContent = $json.data;\n\nif (!csvContent) {\n  throw new Error(\"No CSV data found in 'data' field.\");\n}\n\n// Step 1: Split into lines\nconst rows = csvContent.split(/\\r?\\n/).filter(r => r.trim() !== '');\nconst header = rows[0].split(',').map(h => h.trim());\n\n// Step 2: Parse each row into JSON\nconst items = rows.slice(1).map(row => {\n  const values = [];\n  let inQuotes = false;\n  let current = '';\n\n  for (let i = 0; i < row.length; i++) {\n    const char = row[i];\n    if (char === '\"' && row[i + 1] === '\"') {\n      current += '\"'; // escaped quote\n      i++;\n    } else if (char === '\"') {\n      inQuotes = !inQuotes;\n    } else if (char === ',' && !inQuotes) {\n      values.push(current);\n      current = '';\n    } else {\n      current += char;\n    }\n  }\n  values.push(current);\n\n  const obj = {};\n  header.forEach((h, i) => {\n    obj[h] = values[i] !== undefined ? values[i].trim() : '';\n  });\n\n  return { json: obj };\n});\n\nreturn items;"
      },
