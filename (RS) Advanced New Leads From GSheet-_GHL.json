    {
      "parameters": {
        "jsCode": "// Convert Apollo data to CSV format with all required columns\nconst items = $input.all();\nconst csvRows = ['First Name,Last Name,Email,Company,Phone,Added']; // Header row\n\nitems.forEach(item => {\n  if (item.json.email) {\n    const row = [\n      item.json.first_name || '',\n      item.json.last_name || '',\n      item.json.email || '',\n      item.json.employment_history?.[0]?.organization_name || item.json.organization?.name || '',\n      item.json.phone || '',\n      new Date().toLocaleDateString('en-US', { \n        year: 'numeric', \n        month: 'short', \n        day: 'numeric' \n      })\n    ];\n    \n    // Escape fields that contain commas or quotes\n    const escapedRow = row.map(field => {\n      const str = String(field);\n      if (str.includes(',') || str.includes('\"')) {\n        return `\"${str.replace(/\"/g, '\"\"')}\"`;\n      }\n      return str;\n    });\n    \n    csvRows.push(escapedRow.join(','));\n  }\n});\n\nconst csvContent = csvRows.join('\\n');\n\n// 🔧 Pull random number from \"Telegram Agent\" node\nconst randomNum = $('Telegram Agent').first().json.output['random #'];\n\n// ✅ Build filename dynamically\nconst fileName = `leads_to_verify_${randomNum}.csv`;\n\nreturn {\n  json: {\n    status: 'csv_created',\n    fileName\n  },\n  binary: {\n    data: {\n      data: Buffer.from(csvContent, 'utf8').toString('base64'),\n      mimeType: 'text/csv',\n      fileName\n    }\n  }\n};"
      },
