    {
      "parameters": {
        "promptType": "define",
        "text": "=Content Pillar: {{ $json['All Social - content pillar'] }}\nIdea: {{ $json['All Social - Title'] }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=Write a single paragraph (40–50 words) for LinkedIn describing the topic. Start with the core pain. In one sentence, define the tool, mindset, process, or idea. Give one concrete use case that frees time, add revenue, or scales the business. End by describing what the reader can now do with the saved time (focus, sales, delivery, family). Constraints: one paragraph only; no bullets, no emojis, no hashtags, no questions, no “how to” or “here’s how,” no CTA. Be plain, specific, and credible. Use active voice. Avoid hype.\n\nLastly, create a title for this description.\n"
            },
            {
              "type": "AIMessagePromptTemplate",
              "message": "Randomly choose a viral hook\n\nViral Hook Options (must be rotated, not repeated too often)\n1.\t(#) ways to do (task)\n2.\tStop doing (activity)\n3.\t(Idea) vs (idea)\n4.\tIf you want… do this instead…\n5.\tYour (habit/strategy) is strategically flawed\n6.\tHow to (achieve something)\n7.\tMost people don’t… they just… Why? Because…\n8.\tThe unspoken truth about…\n9.\tHere’s one thing that will change everything…\n10.\tWhat if I told you that…?\n11.\tI used to believe… until I realized…\n12.\tThe single biggest mistake I made when…\n13.\tYou’re wasting your time if…"
            }
          ]
        },
        "batching": {}
      },
